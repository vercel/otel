{
  "name": "@vercel/otel",
  "version": "2.1.4",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Vercel wrapper around OpenTelemetry APIs",
  "author": "Vercel Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/otel.git"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "edge": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/edge/index.js"
      },
      "edge-light": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/edge/index.js"
      },
      "worker": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/edge/index.js"
      },
      "workerd": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/edge/index.js"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "node": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "types": "./dist/types/index.d.ts",
      "default": "./dist/edge/index.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm clean && pnpm tsx build.ts && pnpm build-types && pnpm build-site",
    "build-only": "pnpm tsx build.ts",
    "build-types": "tsc --noEmit false --declaration --emitDeclarationOnly --stripInternal --declarationDir dist/types src/index.ts",
    "build-site": "pnpm build-typedoc && cp index.html LICENSE CHANGELOG.md dist-site",
    "build-typedoc": "pnpm typedoc src/index.ts",
    "clean": "rimraf dist && rimraf dist-site",
    "eslint": "eslint-runner",
    "eslint-fix": "eslint-runner --fix",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit",
    "unit-test": "vitest --run",
    "unit-test-watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/otlp-transformer": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.19.4",
    "eslint-config": "workspace:*",
    "rimraf": "3.0.2",
    "tsx": "^4.6.2",
    "typedoc": "^0.25.8",
    "typescript": "^5",
    "typescript-config": "workspace:*",
    "vitest": "0.33.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "@opentelemetry/instrumentation": ">=0.300.0 <0.400.0",
    "@opentelemetry/resources": ">=3.0.0 <4.0.0",
    "@opentelemetry/sdk-logs": ">=3.0.0 <4.0.0",
    "@opentelemetry/sdk-metrics": ">=3.0.0 <4.0.0",
    "@opentelemetry/sdk-trace": ">=3.0.0 <4.0.0"
  }
}
